{
  "name": "astuteads",
  "version": "1.0.0",
  "description": "AstuteAds: ad spend analysis and recommendations for Meta and Google Ads, on Cloudflare",
  "scripts": {
    "dev": "vite",
    "dev:public": "vite --mode public",
    "build": "vite build",
    "build:public": "vite build --mode public",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:public": "npm run build:public && wrangler deploy",
    "typecheck": "tsc",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinclarkadstech/claudeads.git"
  },
  "bugs": {
    "url": "https://github.com/kevinclarkadstech/claudeads/issues"
  },
  "homepage": "https://github.com/kevinclarkadstech/claudeads#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.20",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "private": true,
  "type": "module"
}
